# Copy this file to .env and fill in your values.
# Never commit .env to source control.

# Database (local dev uses a file path; production uses /data/poc-hunter.db via Fly volume)
DATABASE_PATH=./poc-hunter.db

# GitHub Personal Access Token for the scanner (optional but strongly recommended)
# Increases API rate limit from 60 to 5000 requests/hour.
# Required scopes: none (public repos only)
GITHUB_TOKEN=ghp_your_token_here

# GitHub OAuth app credentials (for user login / votes / comments)
# Create at: https://github.com/settings/developers → OAuth Apps → New OAuth App
# Authorization callback URL: http://localhost:8000/api/v1/auth/github/callback
GITHUB_OAUTH_CLIENT_ID=your_client_id
GITHUB_OAUTH_CLIENT_SECRET=your_client_secret

# Session signing secret – generate a random string: python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=change-me-to-a-random-secret

# Frontend URL (used for OAuth redirect and CORS)
FRONTEND_URL=http://localhost:8000

# Scanner settings
SCAN_INTERVAL_MINUTES=30
MAX_REPOS_PER_SCAN=100
MAX_CONCURRENT_DOWNLOADS=5
MAX_REPO_SIZE_KB=100
RULES_DIR=./Rules
